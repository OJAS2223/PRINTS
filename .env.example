# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Telegram Bot Alert Configuration (For Instant Payment & Ticket Notifications)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# DOB Original PDF Server-Side Secret API
DOB_PRINT_API_URL=https://rtyu.run.place/api/v1/index.php
DOB_PRINT_API_KEY=YOUR_DOB_PRINT_API_KEY
DOB_PRINT_APPLY_SERVICE=b-number-pdf-apply
DOB_PRINT_STATUS_SERVICE=b-number-pdf-status

# Primary Website Domain
SITE_DOMAIN=https://ojasprints.in

# Firebase Admin SDK Service Account JSON (REQUIRED in Vercel Environment Variables for auto-crediting & auto-refunds)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"upeprint","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
